{
  "rewrites": [
    {
      "source": "/content",
      "destination": "https://wordpress-1518437-5838623.cloudwaysapps.com/"
    },
    {
      "source": "/content/",
      "destination": "https://wordpress-1518437-5838623.cloudwaysapps.com/"
    },
    {
      "source": "/content/:path*",
      "destination": "https://wordpress-1518437-5838623.cloudwaysapps.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "X-Forwarded-Host",
          "value": "www.faithtime.ai"
        },
        {
          "key": "X-Forwarded-Proto",
          "value": "https"
        },
        {
          "key": "X-Real-IP",
          "value": "$remote_addr"
        },
        {
          "key": "X-Forwarded-For",
          "value": "$proxy_add_x_forwarded_for"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/content",
      "destination": "/content/",
      "permanent": true
    }
  ]
}
